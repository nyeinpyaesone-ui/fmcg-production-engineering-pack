# Copy to `.env` and fill in real values. PLACEHOLDERS ONLY here — never commit `.env`.
# See docs/DEPLOYMENT.md for the deployment procedure.

POSTGRES_USER=fmcg
POSTGRES_PASSWORD=CHANGE_ME_to_a_long_random_value
POSTGRES_DB=fmcg

# Backend database URL (asyncpg driver). The migrator and backend services
# build their own equivalent from the POSTGRES_* values above; this is used
# for out-of-compose tooling (psql, local runs, backup scripts).
FMCG_DATABASE_URL=postgresql+asyncpg://fmcg:CHANGE_ME_to_a_long_random_value@localhost:5432/fmcg

# Comma-separated browser origins allowed to call the API.
FMCG_CORS_ORIGINS=http://localhost:8080

# Host port publishing the frontend (container always listens on 8080).
FRONTEND_PORT=8080
