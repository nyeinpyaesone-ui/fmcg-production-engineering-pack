# Copy to `.env` and fill in real values. PLACEHOLDERS ONLY here — never commit `.env`.
# See docs/DEPLOYMENT.md for the deployment procedure.

POSTGRES_USER=fmcg
POSTGRES_PASSWORD=CHANGE_ME_to_a_long_random_value
POSTGRES_DB=fmcg

# Backend database URL (asyncpg driver). The migrator and backend services
# build their own equivalent from the POSTGRES_* values above; this is used
# for out-of-compose tooling (psql, local runs, backup scripts).
FMCG_DATABASE_URL=postgresql+asyncpg://fmcg:CHANGE_ME_to_a_long_random_value@localhost:5432/fmcg

# Comma-separated browser origins allowed to call the API.
FMCG_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Host port publishing the frontend (container always listens on 8080).
FRONTEND_PORT=8080

# Production image selection: pull the immutable release artifacts instead of
# building. Set these to the digest refs recorded at release time (GHCR or the
# Docker Hub mirror), then run `docker compose pull`. Staging leaves them unset
# and builds locally. DIGEST REFS ONLY here — never credentials.
# BACKEND_IMAGE=ghcr.io/OWNER/fmcg-erp-backend@sha256:...
# FRONTEND_IMAGE=ghcr.io/OWNER/fmcg-erp-frontend@sha256:...
